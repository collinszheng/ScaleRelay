<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：白色横向圆角卡片 + 薄荷折线。

  几何**逐项照抄 WeightDiary 设计规范 §10.1 的验算**，因为那一节记的是
  「初版卡片四角被系统圆形蒙版削掉」这个实测踩过的坑：
    - 卡片 x 26..82（宽 56），y 33..75（高 42），圆角 13
    - 圆角弧心距中心 √(15² + 8²) = 17.0
    - 最远点 17.0 + 13 = 30.0  <  安全半径 36   ✓
  改这里之前先把上面三个数重算一遍。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 卡片 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M39,33 h34 a13,13 0 0 1 13,13 v16 a13,13 0 0 1 -13,13 h-34 a13,13 0 0 1 -13,-13 v-16 a13,13 0 0 1 13,-13 z" />

    <!-- 卡片上的折线（薄荷色，压在白色卡片上） -->
    <path
        android:strokeColor="#FF3DD68C"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M31,60 L42,49 L51,57 L64,42 L77,55" />
</vector>
